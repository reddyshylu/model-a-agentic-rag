# Copy this file to .env and fill in your own values. Never commit .env.
# All data in this project is FICTIONAL. Never put real patient data here.

# ---- Answer model (Nebius Token Factory, OpenAI-compatible) ----
# LLM_BACKEND=none runs fully offline with template answers (good for tests).
LLM_BACKEND=none
NEBIUS_API_KEY=your_private_nebius_key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Copy the exact model ID from your Nebius model list
NEBIUS_MODEL=

# ---- Retrieval ----
# bm25 = local keyword search, no account needed. pinecone = vector search.
RETRIEVAL=bm25
PINECONE_API_KEY=your_private_pinecone_key
PINECONE_INDEX=model-a
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Tracing (Langfuse) ----
TRACING=off
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Demo clock ----
MODEL_A_TODAY=2026-10-26

# ---- Emergency voice caller (ElevenLabs + Twilio) ----
# off | dry_run (logs the call, never dials) | live
VOICE_MODE=dry_run
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_AGENT_ID=your_emergency_agent_id
ELEVENLABS_PHONE_NUMBER_ID=your_imported_twilio_number_id
ELEVENLABS_WEBHOOK_SECRET=your_post_call_webhook_secret
# The demo "hospital line": your OWN verified phone, in +1XXXXXXXXXX form. Never 911, never a real hospital.
VOICE_CARE_TEAM_NUMBER=+1XXXXXXXXXX
# Every number the caller may dial, comma separated. Anything else is refused.
VOICE_ALLOWED_NUMBERS=+1XXXXXXXXXX
VOICE_MAX_CALLS_PER_HOUR=5

# ---- "Listen" voice layer ----
# Uses ELEVENLABS_API_KEY above. Without a voice id, the app shows the spoken text instead of audio.
ELEVENLABS_VOICE_ID=your_voice_id
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
